{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"]
    },
    "freepik-fastmcp": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "packages/freepik-fastmcp",
        "main.py"
      ],
      "env": {
        "FREEPIK_API_KEY": "${FREEPIK_API_KEY}"
      }
    },
    "perplexity": {
      "command": "bash",
      "args": ["scripts/mcp-npx.sh", "-y", "@perplexity-ai/mcp-server@0.9.0"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "playwright": {
      "command": "bash",
      "args": ["scripts/mcp-npx.sh", "-y", "@playwright/mcp@0.0.73"]
    },
    "firecrawl": {
      "command": "bash",
      "args": ["scripts/mcp-npx.sh", "-y", "firecrawl-mcp@3.14.1"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "chrome-devtools": {
      "command": "bash",
      "args": ["scripts/mcp-npx.sh", "-y", "chrome-devtools-mcp@0.23.0"]
    },
    "notebooklm": {
      "command": "bash",
      "args": ["scripts/mcp-npx.sh", "-y", "@roomi-fields/notebooklm-mcp@1.5.9"]
    },
    "instaloader": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "packages/instaloader-mcp",
        "main.py"
      ],
      "env": {
        "INSTALOADER_USERNAME": "${INSTALOADER_USERNAME}",
        "INSTALOADER_PASSWORD": "${INSTALOADER_PASSWORD}",
        "INSTALOADER_SESSION_USERNAME": "${INSTALOADER_SESSION_USERNAME}",
        "INSTALOADER_SESSION_FILE": "${INSTALOADER_SESSION_FILE}"
      }
    },
    "capsulehub": {
      "command": "bash",
      "args": [
        "scripts/mcp-npx.sh",
        "-y",
        "mcp-remote@0.1.38",
        "https://backend.tilantra.com/mcp/",
        "--header",
        "X-API-Key:${CAPSULEHUB_API_KEY}",
        "--transport",
        "sse-only"
      ],
      "env": {
        "CAPSULEHUB_API_KEY": "${CAPSULEHUB_API_KEY}"
      }
    },
    "apify": {
      "command": "bash",
      "args": ["scripts/mcp-npx.sh", "-y", "@apify/actors-mcp-server@0.9.20"],
      "env": {
        "APIFY_TOKEN": "${APIFY_API_TOKEN}"
      }
    }
  }
}
