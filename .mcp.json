{
  "mcpServers": {
    "earshot": {
      "command": "uv",
      "args": ["run", "--no-project", "--python", "3.12", "scripts/earshot.py", "mcp"],
      "env": {"EARSHOT_THREADS": "3"}
    },
    "figma": {
      "type": "http",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "playwright": {
      "command": "node",
      "args": [
        "scripts/mcp-npx.mjs",
        "-y",
        "@playwright/mcp@0.0.84",
        "--user-data-dir",
        "~/.agency/chrome-instagram-cdp",
        "--output-dir",
        "~/.agency/playwright-mcp-output"
      ]
    },
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp@2.0.0"]
    },
    "higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "magnific": {
      "type": "http",
      "url": "https://mcp.magnific.com"
    },
    "gimp": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/gimp-mcp/gimp-mcp@7325865385541a01aaf336ebc93b00332297f77f",
        "gimp-mcp-server"
      ]
    }
  }
}
