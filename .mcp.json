{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"]
    },
    "freepik": {
      "command": "mcp-remote-n22",
      "args": [
        "https://api.freepik.com/mcp",
        "--header",
        "x-freepik-api-key:${FREEPIK_API_KEY}"
      ],
      "env": {
        "FREEPIK_API_KEY": "${FREEPIK_API_KEY}"
      }
    }
  }
}
