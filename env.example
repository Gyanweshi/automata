# --- This machine -------------------------------------------------------------------------------------------
# Obsidian vault folder. Leave empty for no vault: notes, drafts and session logs then stay in workspace/vault
# (same layout, git-ignored, never cleaned). The bootstrap asks for this once and writes it to .env.
# OBSIDIAN_VAULT_PATH=/path/to/your/vault
# What this machine is for, so the bootstrap installs (and the doctor checks) only those optional tools:
# comma list of research, video, slides, images, 3d, or all. Empty = none. The bootstrap asks for this once.
# AUTOMATA_ROLES=research,video

# Copy these lines into your shell profile, or create a local .env file for tools that load one.
# Never commit real API keys.

GLIF_API_TOKEN=your_glif_token_here

# Optional research integrations used by the Python research package.
APIFY_API_TOKEN=your_apify_token_here
FB_PAGE_ACCESS_TOKEN=your_facebook_page_token_here
