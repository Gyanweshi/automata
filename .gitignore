# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment files
.env
.tools/
.env.*
*.env

# Brand profiles — stored in Obsidian vault, not committed
brands/*.yaml
brands/*.md
!brands/_template.yaml
!brands/example-brand.yaml

# Workspace outputs (generated content — don't commit by default)
workspace/research/*/
workspace/storyboards/*/
workspace/content/*/
!workspace/research/.gitkeep
!workspace/storyboards/.gitkeep
!workspace/content/.gitkeep

# Local vector databases
chroma_db/

# API keys and secrets
*.key
secrets.yaml

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp
