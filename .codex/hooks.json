{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python 3.12 scripts/hooks/skill_routing_context.py session",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python 3.12 scripts/hooks/skill_routing_context.py prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
